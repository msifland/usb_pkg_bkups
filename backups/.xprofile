#!/bin/sh
# Custom resolution – generated Tue Dec  9 08:30:28 AM CST 2025
# Find the correct DISPLAY and XAUTHORITY at login time
DISPLAY=$(w -h $(id -u) 2>/dev/null | awk '/[:][0-9][0-9]*[ ]/{print $3; exit}')
export DISPLAY
export XAUTHORITY="$HOME/.Xauthority"

# Clean any previous instance of this mode
xrandr --rmmode "1800x1012_60.00" 2>/dev/null || true
xrandr --delmode "Virtual-1" "1800x1012_60.00" 2>/dev/null || true

# Create and apply the new mode
xrandr --newmode "1800x1012_60.00" 150.50  1800 1912 2096 2392  1012 1015 1025 1050 -hsync +vsync
xrandr --addmode "Virtual-1" "1800x1012_60.00"
xrandr --output "Virtual-1" --mode "1800x1012_60.00" --primary

sleep 1   # small delay helps on some drivers
