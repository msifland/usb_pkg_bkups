#!/bin/sh
# The following two lines are for NVIDIA only(possibly for hdmi to work). Uncomment to use these lines.
#xrandr --setprovideroutputsource NVIDIA-GO modesetting
#xrandr --auto
xrandr --newmode "1800x1012_60.00"  150.50  1800 1912 2096 2392  1012 1015 1025 1050 -hsync +vsync
xrandr --addmode Virtual-1 1800x1012_60.00
xrandr --output Virtual-1 --mode 1800x1012_60.00
