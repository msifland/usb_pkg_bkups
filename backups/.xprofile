#!/bin/sh
# Custom resolution – generated Sun Nov 30 12:22:50 PM CST 2025
# Find the correct DISPLAY and XAUTHORITY at login time
DISPLAY=$(w -h $(id -u) 2>/dev/null | awk '/[:][0-9][0-9]*[ ]/{print $3; exit}')
export DISPLAY
export XAUTHORITY="$HOME/.Xauthority"

# Clean any previous instance of this mode
xrandr --rmmode "1752x985_60.00" 2>/dev/null || true
xrandr --delmode "eDP-1" "1752x985_60.00" 2>/dev/null || true

# Create and apply the new mode
xrandr --newmode "1752x985_60.00" 142.50  1752 1856 2040 2328  985 988 998 1022 -hsync +vsync
xrandr --addmode "eDP-1" "1752x985_60.00"
xrandr --output "eDP-1" --mode "1752x985_60.00" --primary

sleep 1   # small delay helps on some drivers
